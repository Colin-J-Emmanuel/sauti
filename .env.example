# Sauti environment variables
# Copy to .env for local development, and add the same values in Render → Environment.
# Never commit .env. Values go right after the "=", with no quotes.

# ── PayPal (sandbox) ──────────────────────────────────────────────
# developer.paypal.com → Apps & Credentials (Sandbox) → your app.
# The app needs the Invoicing feature switched on.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Lets Sauti confirm payment notifications really come from PayPal.
# After deploying: your app → Webhooks → Add webhook
#   URL:    https://<your-render-url>/api/paypal/webhook
#   Events: Invoice paid, Invoice cancelled
PAYPAL_WEBHOOK_ID=

# PayPal can't invoice in shillings: the ledger stays in TZS and invoices go out in USD at this rate.
TZS_PER_USD=2500

# ── AI ────────────────────────────────────────────────────────────
# Claude thinks and calls the ledger + PayPal tools: console.anthropic.com → API Keys
ANTHROPIC_API_KEY=
# ElevenLabs turns Swahili voice notes into text: elevenlabs.io → Developers → API Keys
# (the key only needs Speech to Text access)
ELEVENLABS_API_KEY=

# Models as provider:model. Comma-separated = fallbacks, tried in order if one is busy.
AGENT_MODELS=anthropic:claude-haiku-5-5,anthropic:claude-sonnet-5-5
TRANSCRIBE_MODEL=elevenlabs:scribe_v2
# Optional: force one language ("swa" = Swahili). Leave empty to auto-detect Swahili or English.
TRANSCRIBE_LANGUAGE=

# ── WhatsApp (Meta WhatsApp Cloud API) ────────────────────────────
# developers.facebook.com → your app → WhatsApp → API Setup (Step 1. Try it out)
# Access token: "Generate token". The temporary one expires after 24 hours;
# use a System User token for anything longer.
WHATSAPP_TOKEN=
# The test number's Phone Number ID (not the Messaging account ID)
WHATSAPP_PHONE_NUMBER_ID=
# A phrase you make up. Type the same phrase into WhatsApp → Configuration → Webhook → Verify token.
WHATSAPP_VERIFY_TOKEN=
# App settings → Basic → App secret. Lets Sauti confirm messages really come from Meta.
WHATSAPP_APP_SECRET=
# Graph API version, as shown in Meta's sample code
WHATSAPP_GRAPH_VERSION=v25.0

# Optional: the shopkeeper's WhatsApp number for payment alerts, digits only (e.g. 19175550123).
# Leave empty to use whoever last messaged Sauti.
SHOP_WHATSAPP_TO=
# Send "⏳ writing it down…" while a voice note is being processed. Set false to turn it off.
WHATSAPP_ACK=true

# ── Local testing only ────────────────────────────────────────────
# Skip signature checks so you can send fake webhooks with curl. Never set these to true on Render.
SKIP_WEBHOOK_VERIFY=false
SKIP_WHATSAPP_VERIFY=false
