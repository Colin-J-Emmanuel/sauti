# PayPal sandbox app: developer.paypal.com → Apps & Credentials (Sandbox) → your app
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Claude (thinks + calls the PayPal tools): https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=
# ElevenLabs (Swahili voice notes → text): https://elevenlabs.io → Developers → API Keys
ELEVENLABS_API_KEY=

# Models as provider:model, comma-separated = fallbacks in order
AGENT_MODELS=anthropic:claude-haiku-5-5,anthropic:claude-sonnet-5-5
TRANSCRIBE_MODEL=elevenlabs:scribe_v2
# Optional: force a language ("swa" = Swahili). Leave unset to auto-detect Swahili/English.
TRANSCRIBE_LANGUAGE=

# PayPal can't invoice in TZS, so shilling amounts are converted to USD for the invoice.
TZS_PER_USD=2500

# Webhooks (after deploying): developer.paypal.com → your app → Webhooks → Add webhook
#   URL: https://<your-render-url>/api/paypal/webhook
#   Events: INVOICING.INVOICE.PAID, INVOICING.INVOICE.CANCELLED
PAYPAL_WEBHOOK_ID=

# Local testing only: lets you curl a fake webhook without a PayPal signature. Never set in production.
SKIP_WEBHOOK_VERIFY=false

# WhatsApp via the Twilio Sandbox (twilio.com → Console → Messaging → Try it out → WhatsApp)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Optional: the shopkeeper's WhatsApp for payment alerts (defaults to whoever last messaged Sauti)
SHOP_WHATSAPP_TO=
# "⏳ writing it down" reply to voice notes (costs 1 message each). Set false to save trial messages.
WHATSAPP_ACK=true
# Local curl testing only. Never set in production.
SKIP_TWILIO_VERIFY=false
